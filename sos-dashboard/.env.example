DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
PORT=3000

# ---------------------------------------------------------------------------
# Route planner integration (overture-test backend on the VPS)
# ---------------------------------------------------------------------------

# Public URL of the FastAPI route planner, published through the outbound
# tunnel (e.g. https://<hash>.proxy.netbird.io).  The browser on Vercel calls
# this directly - VITE_ vars are inlined at build time, so set them in the
# Vercel project environment and rebuild.  Leave empty to run the demo with
# straight-line fallback routes (no building avoidance).
VITE_PLANNER_API_URL=

# Optional shared secret - sent as X-API-Key on every planner request.  Only
# needed when the backend enforces PLANNER_API_KEY (recommended for the
# public tunnel URL).
VITE_PLANNER_API_KEY=

# ---------------------------------------------------------------------------
# Runtime planner config (server-side, served to the frontend at
# /api/planner-config - no frontend rebuild needed when these change)
# ---------------------------------------------------------------------------

# The tunnel URL rotates whenever the VPS tunnel process restarts.  Update
# these server-side vars + redeploy (Vercel dashboard) and the deployed app
# picks them up at startup - the VITE_ values above are only a fallback.
PLANNER_API_URL=
PLANNER_API_KEY=
