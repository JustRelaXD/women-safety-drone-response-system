# Copy this file to .env and fill in real values. Never commit .env.

# Required: your Anthropic API key. Keep this server-side only — never
# expose it to the frontend or commit it to source control.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Model used by all agents. Override per-agent below if you want to mix models.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Port the Express server listens on.
PORT=8787

# Comma-separated list of origins allowed to call this API (your frontend URL).
CORS_ORIGIN=http://localhost:5173

# Session secret used to sign session identifiers. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Node environment
NODE_ENV=development
