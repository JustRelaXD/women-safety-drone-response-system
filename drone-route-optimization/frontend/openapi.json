{
  "openapi": "3.1.0",
  "info": {
    "title": "Emergency Response Drone Route Planner",
    "description": "A*/Theta*/visibility-graph route planner over Overture Maps data (GPS waypoints only).",
    "version": "0.1.0"
  },
  "paths": {
    "/no-fly-zones": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "No Fly Zones",
        "description": "The imported DGCA airspace overlay (red/amber rings + snapshot age).\n\nReads a local snapshot produced by ``scripts/import_no_fly_zones.py``.\n``scope`` selects which snapshot to serve (``settings.no_fly_zones_files``,\ne.g. ``punjab`` or ``india``); an empty zone list when the scope is\nunknown or its file is missing.  The default ``punjab`` scope falls\nback to ``settings.no_fly_zones_file`` so existing deployments keep\nworking unchanged.  Serves the frontend map overlay; the planner\nitself consumes the same rings via config (display scope never\nchanges the planner's obstacle set).",
        "operationId": "no_fly_zones_no_fly_zones_get",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "punjab",
              "title": "Scope"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoFlyZonesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/generate-route": {
      "post": {
        "tags": [
          "planning"
        ],
        "summary": "Generate Route",
        "operationId": "generate_route_generate_route_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/replan": {
      "post": {
        "tags": [
          "planning"
        ],
        "summary": "Replan",
        "description": "Recompute the route from the current position (same semantics as\ngenerate-route; kept as a separate endpoint so controllers can call\nit mid-mission without re-sending mission metadata).",
        "operationId": "replan_replan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/mission": {
      "post": {
        "tags": [
          "planning"
        ],
        "summary": "Create Mission",
        "operationId": "create_mission_mission_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
