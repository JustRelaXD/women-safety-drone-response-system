# Base URL of the Naira backend (without the /api suffix).
# - Web build on Vercel: leave unset — the app calls the same origin (/api).
# - Local native dev: point at your locally running backend, e.g.
#   EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
# - Native build pointing at the deployed API:
#   EXPO_PUBLIC_BACKEND_URL=https://<your-deployment>.vercel.app
EXPO_PUBLIC_BACKEND_URL=
