# Twilio SMS delivery (leave unset to keep in-app provider-pending status)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Alternative to TWILIO_FROM_NUMBER:
TWILIO_MESSAGING_SERVICE_SID=
# Public POST endpoint configured in Twilio Console:
TWILIO_STATUS_CALLBACK_URL=https://your-public-api.example.com/api/twilio/status